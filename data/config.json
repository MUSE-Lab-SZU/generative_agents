{
    "agent": {
        "percept": {
            "mode": "box",
            "vision_r": 8,
            "att_bandwidth": 8
        },
        "schedule": {
            "max_try": 5,
            "diversity": 5
        },
        "think": {
            "llm": {
                "provider": "openai",
                "model": "qwen3-8b-vllm",
                "base_url": "http://127.0.0.1:18000/v1",
                "api_key": "EMPTY",
                "retry": 3,
                "request_timeout_seconds": 120
            },
            "poignancy_max": 150
        },
        "chat_iter": 4,
        "associate": {
            "embedding": {
                "provider": "openai",
                "model": "bge-m3-vllm",
                "base_url": "http://127.0.0.1:18001/v1",
                "api_key": "EMPTY"
            },
            "retention": 32,
            "chat_retrieve": {
                "mode": "direct",
                "similarity_top_k": -1
            }
        },
        "chat_history": {
            "summary_window_minutes": -1,
            "max_read_items": -1,
            "focus_retrieve_max": 10,
            "recent_turn_focus_n": 10
        },
        "chat_memory": {
            "write_mode": "hybrid"
        }
    },
    "record_interval": 30
}
