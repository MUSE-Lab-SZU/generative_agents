                "duration": 30,
                "doctor": "蜻蜓队长",
                "patient": "卡布达",
                "enabled": false
            },
            {
                "rule_id": "fast_every_4step",
                "type": "interval_steps",
                "interval_steps": 4,
                "step_phase": 1,
                "duration": 1440,
                "doctor": "蜻蜓队长",
                "patient": "卡布达",
                "enabled": true
            },
            {
                "rule_id": "fast_every_2step_jgcl",
                "type": "interval_steps",
                "interval_steps": 2,
                "step_phase": 0,
                "duration": 1440,
                "doctor": "蜻蜓队长",
                "patient": "金龟次郎",
                "enabled": false
            },
            {
                "rule_id": "prod_weekly_monday_1400",
                "type": "weekly",
                "weekday": 1,
                "time": "14:00",
                "duration": 30,
                "doctor": "蜻蜓队长",
                "patient": "卡布达",
                "enabled": false
