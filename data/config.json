                "蜻蜓队长": {
                    "enabled": true,
                    "forced_only": true,
                    "forced_chat_iter": 18,
                    "repeat_break_threshold": 100,
                    "forced_chat_min_turns": 2,
                    "forced_chat_max_turns": -1
                }
            }
        },
        "forced_llm": {
            "enabled": true,
