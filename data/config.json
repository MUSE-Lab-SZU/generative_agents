{
  "agent": {
    "percept": {
      "mode": "box",
      "vision_r": 8,
      "att_bandwidth": 8
    },
    "schedule": {
      "max_try": 5,
      "diversity": 5
    },
    "think": {
      "llm": {
        "provider": "openai",
        "model": "qwen3-8b-vllm",
        "base_url": "http://127.0.0.1:18000/v1",
        "api_key": "EMPTY",
        "retry": 3,
        "request_timeout_seconds": 120,
        "load_balancing": {
          "enabled": true,
          "ports": [
            18000,
            18002
          ]
        }
      },
      "interval": 1000,
      "poignancy_max": 50,
      "reflect_focus_topk": 4,
      "reflect_insights_topk": 1,
      "reflection_policy": {
        "legacy_poignancy": {
          "enabled": false
        },
        "periodic": {
          "enabled": true,
          "interval_steps": 6,
          "targets": "all_agents"
        },
        "conditional": {
          "enabled": true,
          "rules": [
            {
              "event": "after_chat",
              "meeting_kind": "doctor_consult",
              "target_role": "patient",
              "once_per_meeting": true
            },
            {
              "event": "after_chat",
              "meeting_kind": "resident_chat",
              "target_role": "patient",
              "once_per_meeting": true
            },
            {
              "event": "environment_task_result",
              "meeting_kind": "doctor_consult",
              "target_role": "patient",
              "once_per_task_batch": true
            }
          ]
        }
      }
    },
    "chat_iter": 3,
    "associate": {
      "embedding": {
        "provider": "openai",
        "model": "bge-m3-vllm",
        "base_url": "http://127.0.0.1:18001/v1",
        "api_key": "EMPTY",
        "load_balancing": {
          "enabled": true,
          "ports": [
            18001,
            18004
          ]
        }
      },
      "retention": 32,
      "recent_dedup_limit": 0,
      "recency_decay": 0.995,
      "recency_weight": 0.5,
      "relevance_weight": 5.0,
      "importance_weight": 1.0,
      "chat_retrieve": {
        "mode": "direct",
        "similarity_top_k": 3
      }
    },
    "chat_history": {
      "summary_window_minutes": 60480,
      "max_read_items": 2,
      "focus_retrieve_max": 10,
      "recent_turn_focus_n": 15,
      "normal_chat_min_interval_minutes": 2880
    },
    "chat_memory": {
      "write_mode": "hybrid"
    },
    "memory_write_control": {
      "enabled": false,
      "target_agents": [],
      "blocked_node_types": []
    },
    "external_memory": {
      "enabled": false,
      "base_url": "http://localhost:8031",
      "timeout": 10.0,
      "read_mode": "chat_only",
      "fallback_to_local": true,
      "short_term_recent_n": 20,
      "ingest_template_file": "data/prompts/external_memory_ingest.txt",
      "updata_to_L2_apply_scenes": [
        "all_session_chat"
      ],
      "updata_to_milestone_apply_scenes": [
        "session2.3_completed",
        "session3.3-A_completed",
        "session4.2_completed"
      ]
    }
  },
  "intervention": {
    "cbt_controller_mode": "legacy",
    "cbt_controller_version": "minimal_v2_stage_adapter",
    "progressive_d": {
      "enabled": false,
      "controller_version": "progressive_d_v3_1_calibrated_batch_control",
      "state_tracker": {
        "prompt_file": "data/prompts/intervention/state_tracker_progressive_d.txt",
        "retry": 3,
        "recent_utterances": 8
      },
      "judge": {
        "prompt_file": "data/prompts/intervention/dialog_judge_progressive_d.txt",
        "retry": 3
      },
      "control_eval": {
        "route": "forced_llm",
        "prompt_file": "data/prompts/intervention/control_eval_progressive_d.txt",
        "stage_subgoals_file": "data/intervention/cbt_stage_subgoals.json",
        "retry": 3
      },
      "transitions": {
        "allowed_actions": [
          "stay",
          "side_step",
          "soft_step_back",
          "hold"
        ],
        "soft_step_back_predecessors": {}
      }
    },
    "enabled": true,
    "doctor": "蜻蜓队长",
    "patients": [
      "卡布达",
      "金龟次郎"
    ],
    "meeting_queue": {
      "enabled": true,
      "max_queue_per_doctor": 128
    },
    "meeting_rules": [
      {
        "rule_id": "weekly_followup",
        "type": "weekly",
        "weekday": 1,
        "time": "14:00",
        "duration": 30,
        "doctor": "蜻蜓队长",
        "patient": "卡布达",
        "prompt_target": "all",
        "enabled": false
      },
      {
        "rule_id": "every_7_days_followup",
        "type": "interval_days",
        "interval_days": 7,
        "time": "14:00",
        "duration": 30,
        "doctor": "蜻蜓队长",
        "patient": "卡布达",
        "prompt_target": "all",
        "enabled": false
      },
      {
        "rule_id": "fast_every_6h",
        "type": "interval_minutes",
        "interval_minutes": 360,
        "duration": 30,
        "doctor": "蜻蜓队长",
        "patient": "卡布达",
        "prompt_target": "all",
        "enabled": false
      },
      {
        "rule_id": "fast_every_4step",
        "type": "interval_steps",
        "interval_steps": 6,
        "step_phase": 1,
        "duration": 2881,
        "doctor": "蜻蜓队长",
        "patient": "卡布达",
        "prompt_target": "all",
        "enabled": true
      },
      {
        "rule_id": "fast_every_2step_jgcl",
        "type": "interval_steps",
        "interval_steps": 2,
        "step_phase": 0,
        "duration": 1440,
        "doctor": "蜻蜓队长",
        "patient": "金龟次郎",
        "prompt_target": "all",
        "enabled": false
      },
      {
        "rule_id": "prod_weekly_monday_1400",
        "type": "weekly",
        "weekday": 1,
        "time": "14:00",
        "duration": 30,
        "doctor": "蜻蜓队长",
        "patient": "卡布达",
        "prompt_target": "all",
        "enabled": false
      }
    ],
    "resident_chat_scheduler": {
      "enabled": false,
      "rules": []
    },
    "order_extract": {
      "enabled": true,
      "prompt_file": "data/prompts/extract_doctor_order.txt",
      "max_tasks_per_chat": 3
    },
    "environment_model": {
      "enabled": true,
      "route": "forced_llm",
      "prompt_file": "data/prompts/intervention/environment_task_outcome.txt",
      "retry": 2,
      "poignancy": 9,
      "expire_days": 30,
      "max_agents_per_task": 3,
      "reflect_after_injection": true
    },
    "session_prompt_injection": {
      "enabled": true,
      "prompt_file": "data/prompts/intervention_prompts.json",
      "namespace": "CBT",
      "placeholder": "{doctor_session_prompt_injection}",
      "advance_marker": "[SESSION_END]",
      "order": [
        "session1",
        "session2.1",
        "session2.2",
        "session2.3",
        "session3.1",
        "session3.2",
        "session3.3-A",
        "session4.1",
        "session4.2",
        "session4.4"
      ],
      "scope": "forced_chat_only",
      "post_treatment_followup": {
        "enabled": true,
        "prompt_file": "data/prompts/intervention/post_treatment_followup.txt",
        "skip_session_eval": true
      },
      "stop_rule_scheduling_on_session_completed": true
    },
    "chat_controls": {
      "enabled": true,
      "defaults": {
        "enabled": false,
        "forced_only": true,
        "forced_chat_iter": 18,
        "repeat_break_threshold": 1,
        "repeat_detection_enabled": false,
        "forced_chat_min_turns": -1,
        "forced_chat_max_turns": -1,
        "terminate_detection_tail_window_enabled": true,
        "terminate_detection_tail_window_turns": 12
      },
      "agent_overrides": {
        "卡布达": {
          "enabled": true,
          "forced_only": true,
          "forced_chat_iter": 18,
          "repeat_break_threshold": 100,
          "forced_chat_min_turns": 2,
          "forced_chat_max_turns": -1
        },
        "金龟次郎": {
          "enabled": true,
          "forced_only": true,
          "forced_chat_iter": 18,
          "repeat_break_threshold": 100,
          "forced_chat_min_turns": 2,
          "forced_chat_max_turns": -1
        },
        "蜻蜓队长": {
          "enabled": true,
          "forced_only": true,
          "forced_chat_iter": 18,
          "repeat_break_threshold": 100,
          "forced_chat_min_turns": 2,
          "forced_chat_max_turns": -1
        }
      }
    },
    "forced_llm": {
      "enabled": true,
      "provider": "openai",
      "model": "deepseek-v4-flash",
      "base_url": "https://api.deepseek.com",
      "api_key_env": "DEEPSEEK_API_KEY",
      "retry": 5,
      "temperature": 0.5,
      "decide_chat_terminate_retry": 5,
      "decide_chat_terminate_force_forced_llm": true
    },
    "dialog_judge": {
      "enabled": true,
      "prompt_file": "data/prompts/intervention/dialog_judge.txt",
      "legacy_prompt_file": "data/prompts/intervention/dialog_judge_legacy.txt",
      "retry": 3,
      "force_forced_llm": true,
      "patient_state_prompt_file": "data/prompts/intervention/dialog_judge_patient_state_summary.txt",
      "patient_state_summary_retry": 2
    },
    "state_tracker": {
      "enabled": true,
      "prompt_file": "data/prompts/intervention/state_tracker.txt",
      "retry": 3,
      "recent_utterances": 8
    },
    "strategy_router": {
      "strategy_map_file": "data/intervention/cbt_strategy_map.json",
      "term_glossary_file": "data/intervention/cbt_term_glossary.json"
    },
    "session_eval": {
      "enabled": true,
      "route": "forced_llm",
      "prompt_file": "data/prompts/intervention/session_eval.txt",
      "legacy_prompt_file": "data/prompts/intervention/session_eval_legacy.txt",
      "retry": 3,
      "history_recent_n": 3
    },
    "consult_record": {
      "enabled": false,
      "prompt_generate_file": "data/prompts/intervention/consult_record_generate.txt",
      "prompt_injection_file": "data/prompts/intervention/doctor_consult_record_injection.txt",
      "llm_retry": 3,
      "validation": {
        "soap_text_max_len": 300
      },
      "audit": {
        "max_entries": 2000
      }
    },
    "consult_history": {
      "enabled": true,
      "retrieve_top_k": 3,
      "gate_prompt_file": "data/prompts/intervention/consult_history_gate.txt",
      "gate_retry": 2,
      "summary_route": "forced_llm",
      "summary_prompt_file": "data/prompts/intervention/consult_history_summary.txt",
      "summary_retry": 2
    },
    "depression_dynamic": {
      "enabled": true,
      "normal_chain_enabled": true,
      "forced_chain_enabled": true,
      "prompt_injection_enabled": true,
      "event_commit_enabled": true,
      "target_hints": [
        "generate_chat",
        "decide_chat",
        "decide_chat_terminate",
        "summarize_relation",
        "summarize_chats",
        "determine_sector",
        "determine_arena",
        "determine_object",
        "describe_object"
      ],
      "on_missing_agent_config": "warn_and_disable",
      "log_enabled": true
    },
    "memory_injection": {
      "enabled": true,
      "content_file": "data/intervention/memory_injections.json",
      "rules": {
        "init_kabuda_depression_stress": {
          "enabled": true,
          "target_agent": "卡布达",
          "source": "初始化规则注入_卡布达抑郁压力事件",
          "update_to_L2": false,
          "update_to_milestone": true,
          "options": {
            "allow_partial_success": true,
            "dedup_mode": "global"
          }
        },
        "session_completed_memory_rule_kbd": {
          "enabled": false,
          "target_agent": "卡布达",
          "source": "会诊完成注入_多Session记忆_卡布达",
          "trigger": {
            "sessions": [
              "session1",
              "session2.1",
              "session4.4"
            ]
          },
          "update_to_L2": true,
          "update_to_milestone": false,
          "options": {
            "allow_partial_success": true,
            "dedup_mode": "global",
            "max_items_per_session": 3
          }
        }
      },
      "defaults": {
        "poignancy": 5,
        "expire_days": 30,
        "address_mode": "current_tile",
        "allow_partial_success": true,
        "dedup_mode": "global"
      },
      "limits": {
        "max_items_per_request": 20,
        "max_describe_chars": 1000,
        "max_audit_entries": 2000,
        "max_fingerprints": 20000
      }
    },
    "memory_policy": {
      "enabled": true,
      "scope": "forced_chat_only",
      "forced_chat_expire_days": -1,
      "retrieve_profile": {
        "recency_weight_multiplier": 1.0,
        "relevance_weight_multiplier": 1.0,
        "importance_weight_multiplier": 1.0,
        "role_bonus": {
          "enabled": true,
          "doctor": "蜻蜓队长",
          "patients": [
            "卡布达",
            "金龟次郎"
          ],
          "bonus": 0.4
        }
      }
    }
  },
  "checkpointing": {
    "enabled": true,
    "mode": "consult_sparse",
    "periodic_every_steps": 56,
    "write_final_snapshot": true,
    "write_on_staged_eval_trigger": true,
    "event_log": {
      "enabled": true,
      "filename": "simulation_events.jsonl",
      "record_interactions": true,
      "record_agent_states": true
    },
    "rolling_resume": {
      "enabled": true
    }
  },
  "staged_eval": {
    "enabled": true,
    "execution_mode": "capture_only",
    "target_agent": "卡布达",
    "include_t0": true,
    "session_interval": 4,
    "max_completed_sessions": 1000,
    "step_interval": {
      "enabled": false,
      "every_steps": 24,
      "virtual_session_interval": 4,
      "label_prefix": "session",
      "max_triggers": 0
    },
    "t4_enabled": false,
    "t4_after_steps": 8,
    "auto_stop_after_t4_done": false,
    "worker_script": "runshells/run_staged_eval_worker.py",
    "worker_timeout_seconds": 7200,
    "cleanup_tmp_storage": true,
    "scales": [
      "PHQ-9",
      "BDI-II"
    ]
  }
}
