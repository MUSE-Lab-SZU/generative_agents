{
    "agent": {
        "percept": {
            "mode": "box",
            "vision_r": 8,
            "att_bandwidth": 8
        },
        "schedule": {
            "max_try": 5,
            "diversity": 5
        },
        "think": {
            "llm": {
                "provider": "ollama",
                "model": "qwen3:8b-q4_K_M",
                "base_url": "http://127.0.0.1:11434/v1",
                "api_key": ""
            },
            "interval": 1000,
            "poignancy_max": 75
        },
        "chat_iter": 4,
        "associate": {
            "embedding": {
                "provider": "ollama",
                "model": "bge-m3:latest",
                "base_url": "http://127.0.0.1:11434",
                "api_key": ""
            },
            "retention": 32,
            "recency_decay": 0.995,
            "recency_weight": 0.5,
            "relevance_weight": 5.0,
            "importance_weight": 1.0,
            "chat_retrieve": {
                "mode": "semantic",
                "similarity_top_k": 6
            }
        },
        "chat_history": {
            "summary_window_minutes": -1,
            "max_read_items": -1,
            "focus_retrieve_max": 10,
            "recent_turn_focus_n": 10
        },
        "chat_memory": {
            "write_mode": "hybrid"
        },
        "external_memory": {
            "enabled": true,
            "base_url": "http://localhost:8031",
            "timeout": 10.0,
            "read_mode": "chat_only",
            "fallback_to_local": true,
            "short_term_recent_n": 20,
            "ingest_template_file": "data/prompts/external_memory_ingest.txt",
            "updata_to_L2_apply_scenes": [
                "all_session_chat"
